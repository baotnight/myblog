---
import type { Post } from "@utils/posts";
import { formatDate, toISODate } from "@utils/date";

interface Props {
	post: Post;
	prev?: Post;
	next?: Post;
}

const { post, prev, next } = Astro.props;
const { title, published, updated, tags, category, author } = post.data;
---

<article>
	<header class="post-header">
		<h1>{title}</h1>
		<div class="post-meta">
			<time datetime={toISODate(published)}>{formatDate(published)}</time>
			{category && <span>· {category}</span>}
			{author && <span>· {author}</span>}
			{updated && <span>· 更新于 {formatDate(updated)}</span>}
		</div>
		{
			tags.length > 0 && (
				<div class="post-meta" style="margin-top:0.6rem">
					{tags.map((tag: string) => (
						<span class="tag">#{tag}</span>
					))}
				</div>
			)
		}
	</header>

	<div class="prose">
		<slot />
	</div>

	{(prev || next) && (
		<nav class="post-nav" aria-label="上下篇">
			<span>{prev && <a href={`/posts/${prev.id}/`}>← {prev.data.title}</a>}</span>
			<span style="text-align:right">
				{next && <a href={`/posts/${next.id}/`}>{next.data.title} →</a>}
			</span>
		</nav>
	)}
</article>
